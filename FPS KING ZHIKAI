local function GetColor(Value)
	if Value >= 120 then
		return Color3.fromRGB(90, 255, 150)
	elseif Value >= 60 then
		return Color3.fromRGB(145, 255, 105)
	elseif Value >= 45 then
		return Color3.fromRGB(255, 220, 90)
	elseif Value >= 30 then
		return Color3.fromRGB(255, 165, 75)
	else
		return Color3.fromRGB(255, 85, 100)
	end
end

local Dragging = false
local DragStart
local StartPosition

Title.InputBegan:Connect(function(Input)
	if Input.UserInputType == Enum.UserInputType.MouseButton1
		or Input.UserInputType == Enum.UserInputType.Touch then

		Dragging = true
		DragStart = Input.Position
		StartPosition = Main.Position
	end
end)

UserInputService.InputEnded:Connect(function(Input)
	if Input.UserInputType == Enum.UserInputType.MouseButton1
		or Input.UserInputType == Enum.UserInputType.Touch then

		Dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(Input)
	if not Dragging then
		return
	end

	if Input.UserInputType == Enum.UserInputType.MouseMovement
		or Input.UserInputType == Enum.UserInputType.Touch then

		local Delta = Input.Position - DragStart

		Main.Position = UDim2.new(
			StartPosition.X.Scale,
			StartPosition.X.Offset + Delta.X,
			StartPosition.Y.Scale,
			StartPosition.Y.Offset + Delta.Y
		)
	end
end)

Close.MouseButton1Click:Connect(function()
	Gui:Destroy()
end)

local Frames = 0
local TotalFrames = 0
local TotalTime = 0
local UpdateTimer = 0

local Samples = table.create(240)
local SampleIndex = 0
local SampleCount = 0

RunService.RenderStepped:Connect(function(DeltaTime)
	Frames += 1
	TotalFrames += 1
	TotalTime += DeltaTime
	UpdateTimer += DeltaTime

	local InstantFPS = 1 / math.max(DeltaTime, 1 / 1000)

	SampleIndex += 1

	if SampleIndex > 240 then
		SampleIndex = 1
	end

	Samples[SampleIndex] = InstantFPS

	if SampleCount < 240 then
		SampleCount += 1
	end

	if UpdateTimer >= 0.25 then
		local CurrentFPS = Frames / UpdateTimer
		local AverageFPS = TotalFrames / math.max(TotalTime, 0.001)

		local Sorted = table.create(SampleCount)

		for i = 1, SampleCount do
			Sorted[i] = Samples[i]
		end

		table.sort(Sorted)

		local LowIndex = math.max(1, math.floor(SampleCount * 0.01))
		local LowFPS = Sorted[LowIndex] or CurrentFPS

		local FrameMS = DeltaTime * 1000
		local Color = GetColor(CurrentFPS)

		FPS.Text = tostring(math.floor(CurrentFPS + 0.5))
		FPS.TextColor3 = Color

		Current.Text = tostring(math.floor(CurrentFPS + 0.5))
		Average.Text = tostring(math.floor(AverageFPS + 0.5))
		Low.Text = tostring(math.floor(LowFPS + 0.5))

		FrameTime.Text = string.format("%.2f ms", FrameMS)

		local Fill = math.clamp(CurrentFPS / 144, 0, 1)

		TweenService:Create(
			Bar,
			TweenInfo.new(0.2, Enum.EasingStyle.Quad),
			{
				Size = UDim2.fromScale(Fill, 1),
				BackgroundColor3 = Color
			}
		):Play()

		TweenService:Create(
			Status,
			TweenInfo.new(0.2),
			{BackgroundColor3 = Color}
		):Play()

		TweenService:Create(
			Accent,
			TweenInfo.new(0.2),
			{BackgroundColor3 = Color}
		):Play()

		Frames = 0
		UpdateTimer = 0
	end
end)
